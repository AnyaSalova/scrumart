<%- include('partials/header') %>
<h1>Новая карточка</h1>
<% if (errors.length) { %>
  <div class="error">
    <b>Карточка не создана.</b> Исправьте ошибки:
    <ul><% errors.forEach(function (e) { %><li><%= e %></li><% }) %></ul>
  </div>
<% } %>
<form method="post" action="/cards" class="form">
  <label>Название задачи
    <input name="title" value="<%= form.title || '' %>" placeholder="Например: Монтаж ролика для «Зерна»">
  </label>
  <label>Исполнитель
    <select name="assigneeId">
      <option value="">— выберите —</option>
      <% members.forEach(function (m) { %>
        <option value="<%= m.id %>" <%= form.assigneeId === m.id ? 'selected' : '' %>><%= m.fullName %> (<%= m.role %>)</option>
      <% }) %>
    </select>
  </label>
  <label>Колонка (стадия)
    <select name="column">
      <% columns.forEach(function (c) { %>
        <option value="<%= c.id %>" <%= form.column === c.id ? 'selected' : '' %>><%= c.title %> — <%= c.count %><%= c.wip ? ' из ' + c.wip : '' %></option>
      <% }) %>
    </select>
  </label>
  <label>Приоритет
    <select name="priority">
      <% priorities.forEach(function (p) { %>
        <option <%= form.priority === p ? 'selected' : '' %>><%= p %></option>
      <% }) %>
    </select>
  </label>
  <label>Дедлайн
    <input type="date" name="deadline" value="<%= form.deadline || '' %>">
  </label>
  <label>Описание
    <textarea name="description" rows="3"><%= form.description || '' %></textarea>
  </label>
  <button class="btn" type="submit">Создать карточку</button>
</form>
<%- include('partials/footer') %>
